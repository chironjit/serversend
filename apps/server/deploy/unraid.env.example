# Copy to a persistent directory as serversend.env and set your Unraid LAN IP.
SERVER_SEND_IMAGE=ghcr.io/chironjit/serversend:0.1
SERVER_SEND_BIND_IP=192.168.1.10
SERVER_SEND_TLS_IPS=192.168.1.10
SERVER_SEND_CONFIG_PATH=/mnt/user/appdata/serversend/config
SERVER_SEND_DATA_PATH=/mnt/user/serversend/data
SERVER_SEND_STAGING_PATH=/mnt/user/serversend/staging
